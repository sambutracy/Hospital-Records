{
  "name": "comfort-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src .storybook '*.{ts,json,js}'",
    "storybook": "storybook dev -p 6006",
