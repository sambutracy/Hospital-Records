# make run generates these local secrets and the imported synthetic realm.
# Keep the generated .env and .runtime directory private. Do not reuse demo setup in production.
DJANGO_SECRET_KEY=
DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
KEYCLOAK_DATABASE_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=

# Shared model configuration for the web application's worker and synthetic CLI trial.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# Use the exact base URL in your access email, including /v1.
LLM_BASE_URL=
LLM_API_KEY=

# Explicit hospital search; replace with your own Nominatim endpoint for deployment.
FACILITY_SEARCH_URL=https://nominatim.openstreetmap.org

# Optional fresh-demo isolation; callback origins are fixed when the realm is generated.
APP_HOST=localhost
APP_PORT=8000
KEYCLOAK_PORT=8081
# Default local search sends at most 10 ranked sources; application upper bound is 30.
ASSISTANT_SEARCH_SOURCE_LIMIT=10
# Use an organization-administered lookup endpoint for local deployment; blank disables lookup.
ON_PREMISE_FACILITY_SEARCH_URL=
